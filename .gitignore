# --- LaTeX build artifacts -------------------------------------------------
# The submitted PDFs are committed (see reports/); everything else latexmk
# generates is disposable and regenerated by `make -C reports`.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# --- Data and checkpoints --------------------------------------------------
# MNIST/CIFAR are re-downloaded by scripts/get_mnist.py; model weights are
# reproducible from the training scripts. Neither belongs in git.
data/
*.npz
*.pt
*.pth

# Result JSONs are NOT ignored: they are small, and the report tables are
# generated from them, so they are part of the record.

# Built report PDFs are disposable — rebuild with `make reports`. The copy you
# actually hand in goes in reports/submitted/, which is tracked.
reports/*.pdf
!reports/submitted/*.pdf
